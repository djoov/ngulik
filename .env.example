# Salin file ini menjadi .env lalu isi nilainya.
#   cp .env.example .env
#
# Cara mendapatkan API key ada di README.md bagian "Menyiapkan YouTube API Key".
# File .env sudah masuk .gitignore — jangan pernah commit key kamu.

YOUTUBE_API_KEY=

# Opsional: override lokasi database (default dari config/config.yaml)
# NGULIK_DATABASE=data/ngulik.db

# Opsional: override level logging (DEBUG | INFO | WARNING | ERROR)
# NGULIK_LOG_LEVEL=INFO
